{
  "name": "busybar-claude-code",
  "private": true,
  "version": "0.1.0",
  "description": "Your Claude Code sessions on the bar: who is working, who is done, and permission prompts you answer with the bar's buttons.",
  "author": "BUSY",
  "type": "module",
  "scripts": {
    "typecheck": "tsc",
    "build": "busy-cli build",
    "release": "node tools/release.mjs",
    "app:install": "busy-cli app install",
    "app:uninstall": "busy-cli app uninstall",
    "app:run": "busy-cli app run",
    "app:stop": "busy-cli app stop",
    "daemon": "node ../plugin/daemon/claude-bar-daemon.mjs",
    "images": "node tools/make-images.mjs && python3 tools/pack.py"
  },
  "engines": {
    "node": ">=24 <26"
  },
  "devDependencies": {
    "@busy-app/cli": "^0.6.0",
    "typescript": "~6.0.3",
    "vite": "8.1.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrlunev/busybar-claude-code.git",
    "directory": "app"
  }
}
